{
  "identifier": "default",
  "description": "Permissões básicas da janela principal do Libris.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "opener:allow-open-url",
    "shell:allow-open",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }]
    }
  ]
}